# Formal properties for pio_gpio_mux (KANBAN C7).
# BMC + k-induction prove (+cover) of the SPEC-10-x / SPEC-7-7/8/18 /
# CC-5/CC-6/CC-7/CC-23/CC-24 properties in formal/pio_gpio_mux_fv.sv
# (module pio_gpio_mux_fv).
# NB: files renamed on copy (distinct basenames) — sby copies [files]
# flat into src/.

[tasks]
bmc
prove
cover

[options]
bmc:   mode bmc
bmc:   depth 12
prove: mode prove
prove: depth 12
cover: mode cover
cover: depth 16

# Engines: boolector throughout — every property is an equation over
# inputs, outputs and ported-back internal state (dbg_sticky_*), so
# k-induction converges without a discovered invariant.

[engines]
smtbmc boolector

[script]
read -formal -sv pio_gpio_mux.sv
read -formal -sv pio_gpio_mux_fv.sv
prep -top pio_gpio_mux_fv

[files]
../rtl/pio_gpio_mux.sv
pio_gpio_mux_fv.sv
