# Formal properties for pio_instr_mem (KANBAN C1).
# BMC + k-induction prove of the CC-33 / SPEC-1-2 / SPEC-7-10 properties
# in formal/pio_instr_mem_fv.sv (module pio_instr_mem_fv).
# NB: the RTL and property files are renamed on copy (distinct basenames)
# because sby copies [files] flat into src/.

[tasks]
bmc
prove
cover

[options]
bmc:   mode bmc
bmc:   depth 8
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 12

[engines]
smtbmc z3

[script]
read -formal -sv pio_instr_mem.sv
read -formal -sv pio_instr_mem_fv.sv
prep -top pio_instr_mem_fv

[files]
../rtl/pio_instr_mem.sv
pio_instr_mem_fv.sv
